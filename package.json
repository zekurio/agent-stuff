{
  "name": "@zekurio/agent-stuff",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Personal agent skills and Pi extensions",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "check": "tsc && node --test \"extensions/**/*.test.ts\"",
    "test": "node --test \"extensions/**/*.test.ts\"",
    "typecheck": "tsc",
    "skills:check": "node scripts/update-skills.mjs --check",
    "skills:update": "node scripts/update-skills.mjs"
  },
  "pi": {
    "extensions": [
      "./extensions/firecrawl/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "26.6.6",
    "typebox": "1.3.27",
    "typescript": "7.0.2"
  }
}
